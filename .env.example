# Токен сообщества ВК (Настройки → Работа с API → Ключи доступа)
# Нужны права: messages, photos, manage
# Без photos ВК не даёт прикрепить картинку к сообщению.
VK_TOKEN=vk1.a.xxxxxxxx
# Дополнительные сообщества ВК через запятую. VK_TOKEN уже входит в этот список.
# VK_TOKENS=vk1.a.yyyyyyyy,vk1.a.zzzzzzzz
# Боты Telegram через запятую. Можно указать один токен в TG_TOKEN.
# Люди из всех этих ботов попадают в одну очередь поиска.
# TG_TOKEN=
# TG_TOKENS=123456:AA...,789012:BB...

# Chat API: поиск собеседника и диалоги для ботов и сайта.
# Сервисный токен бота, не короче 16 символов. На сервере deploy/update.sh создаст его сам.
CHAT_API_SERVICE_TOKEN=local-service-token-change-me
# Токен серверного приложения сайта: действует только за пользователей платформы web.
# Не короче 16 символов и не совпадает с CHAT_API_SERVICE_TOKEN. На сервере берётся из ENV_FILE.
# Держит web-gateway; в браузер и в репозиторий не класть.
CHAT_API_APP_TOKEN=local-app-token-change-me
# Подпись гостевых JWT браузера (web-gateway), не короче 32 символов.
GUEST_JWT_SECRET=local-guest-jwt-secret-with-32-characters
# Origins сайта для CORS gateway, через запятую.
CORS_ORIGINS=http://localhost:3000,https://chatwithyou.site
# Токен Cloudflare Tunnel: через него снаружи открыты Studio и Chat API. Локально не нужен.
# CLOUDFLARE_TUNNEL_TOKEN=
# Адреса для запуска бота и API на хосте. В Docker Compose подставляются сами.
CHAT_API_URL=http://localhost:8000
REDIS_URL=redis://localhost:6379/0
# Куда публиковать порт API на хосте. Снаружи его открывает Cloudflare Tunnel.
CHAT_API_PUBLISH=127.0.0.1:8000
# Публичный web-gateway для Iskra (/chat). Локально: http://127.0.0.1:8001
WEB_GATEWAY_PUBLISH=127.0.0.1:8001
# Поддомен gateway на сервере (Caddy). Локально не нужен.
# API_HOST=api.chatwithyou.site


# Supabase Postgres. Эти значения подходят для docker compose из этого репозитория.
# DATABASE_URL нужен Chat API, если он запускается на хосте и ходит в базу на localhost.
# Внутри Docker Compose адрес базы подставляется сам: хост db, пользователь supabase_admin.
POSTGRES_PASSWORD=postgres
POSTGRES_DB=postgres
JWT_SECRET=super-secret-jwt-token-with-at-least-32-characters-long
DATABASE_URL=postgresql://supabase_admin:postgres@localhost:5432/postgres

# Ссылка кнопки оплаты в сообщениях бота.
PREMIUM_URL=https://vk.cc/d2HjY8
# Куда публиковать порт сайта на хосте. Снаружи его открывает Caddy.
PREMIUM_PUBLISH=127.0.0.1:8080
# Поддомены. Пустые локально. На сервере их заполняет deploy/update.sh.
# PAY_HOST=pay.chatwithyou.site
# STUDIO_PUBLIC_URL=https://studio.chatwithyou.site

# Образы бота, Chat API и сайта оплаты. Локально не задавайте: Compose соберёт их сам.
# На сервере CI подставляет имена из Docker Hub, в .env их писать не нужно.
# BOT_IMAGE=username/dating-bot:sha
# CHAT_API_IMAGE=username/dating-chat-api:sha
# PREMIUM_IMAGE=username/dating-premium:sha
# WEB_GATEWAY_IMAGE=username/dating-web-gateway:sha

# Локальная панель Studio: http://127.0.0.1:54323
# Ключ шифрует строки подключения, которые Studio передаёт в postgres-meta.
PG_META_CRYPTO_KEY=local-studio-crypto-key-32-characters
STUDIO_DEFAULT_ORGANIZATION=VK Bot
STUDIO_DEFAULT_PROJECT=vk-bot
