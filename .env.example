# Токен сообщества ВК (Настройки → Работа с API → Ключи доступа)
# Нужны права: messages, manage
VK_TOKEN=vk1.a.xxxxxxxx

# После первой реплики диалог ведёт Abliteration.
# Ключ: https://docs.abliteration.ai/quickstart
ABLIT_KEY=
ABLIT_MODEL=abliterated-model
ABLIT_TIMEOUT=30

# Supabase Postgres. Эти значения подходят для docker compose из этого репозитория.
# DATABASE_URL нужен, если бот запускается на хосте и ходит в базу на localhost.
# Внутри Docker Compose адрес базы подставляется сам: хост db, пользователь supabase_admin.
POSTGRES_PASSWORD=postgres
POSTGRES_DB=postgres
JWT_SECRET=super-secret-jwt-token-with-at-least-32-characters-long
DATABASE_URL=postgresql://supabase_admin:postgres@localhost:5432/postgres

# Сайт оплаты. Это отдельный сервис FastAPI, не бот.
# Публичный адрес, который открывается из ВК. Локально это http://127.0.0.1:8080
PREMIUM_URL=http://127.0.0.1:8080
# Куда публиковать порт сайта. На сервере: 0.0.0.0:8080
PREMIUM_PUBLISH=127.0.0.1:8080

# Локальная панель Studio: http://127.0.0.1:54323
# Ключ шифрует строки подключения, которые Studio передаёт в postgres-meta.
PG_META_CRYPTO_KEY=local-studio-crypto-key-32-characters
STUDIO_DEFAULT_ORGANIZATION=VK Bot
STUDIO_DEFAULT_PROJECT=vk-bot
