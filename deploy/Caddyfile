{$PAY_HOST:pay.chatwithyou.site} {
	# Браузерный chat gateway на уже публичном хосте оплаты:
	# api.chatwithyou.site сейчас за Cloudflare Access (туннель), а pay.* идёт на Caddy.
	handle /api/v1/* {
		reverse_proxy web-gateway:8000
	}
	handle {
		reverse_proxy premium:8000
	}
}

# Когда DNS api.* укажут на этот сервер без Access — тот же gateway.
{$API_HOST:api.chatwithyou.site} {
	reverse_proxy web-gateway:8000
}
